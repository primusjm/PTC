---
layout: base.njk
title: Home
nav: home
description: "Promises Treatment Centre — residential recovery from alcohol and drug addiction in Webuye, Kenya. NACADA accredited."
---
<div class="grid-hero">
  <div class="hero-copy">
    <div class="kicker">{% icon "map-pin" %}{{ home.kicker }}</div>
    <h1 class="h1">{{ home.heroTitle }}</h1>
    <p class="p-lead">{{ home.heroBody }}</p>
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,230px),1fr));gap:14px;padding-top:4px;max-width:600px">
      <a href="tel:{{ site.phoneHref }}" class="btn btn-primary">{% icon "phone" %}Call us now</a>
      <a href="https://wa.me/{{ site.whatsapp }}?text={{ site.whatsappMessage | urlencode }}" class="btn btn-wa" rel="noopener">{% icon "message-circle" %}WhatsApp Us</a>
    </div>
    <div style="display:flex;align-items:center;gap:10px;font-size:0.9062rem;color:var(--muted)">
      <span style="width:7px;height:7px;border-radius:50%;background:#5C6B57;display:inline-block;flex:0 0 auto"></span>
      <span>Lines open daily. Every conversation stays between us.</span>
    </div>
  </div>
  <div class="hero-media">
    {% image home.heroImage, "A close-up of two people holding each other's hands", "(min-width: 900px) 50vw, 100vw", "", "", "eager" %}
    <span class="hero-caption">{{ home.heroQuote }}</span>
  </div>
</div>

<div class="grid-trust">
  {% set trustIcons = ["shield-check", "clock", "users", "refresh-cw"] %}
{% for t in home.trust %}
  <div class="trust-item">
    <span class="icon-tile" style="align-self:flex-start;margin-bottom:6px">{% icon trustIcons[loop.index0] %}</span>
    <div class="title">{{ t.title }}</div>
    <div class="body">{{ t.body }}</div>
  </div>
  {% endfor %}
</div>

<div id="about" class="section grid grid-2">
  <div style="display:flex;flex-direction:column;gap:24px">
    <div class="kicker">{% icon "home" %}{{ home.aboutKicker }}</div>
    <h2 class="h2">{{ home.aboutTitle }}</h2>
    <div class="slideshow" data-slideshow role="group" aria-roledescription="carousel" aria-label="Photos of the centre">
      <div class="slides" aria-live="off">
        {% for s in home.aboutSlides %}{% image s.image, s.alt, "(min-width: 900px) 45vw, 100vw", ("slide active" if loop.first else "slide"), "", ("eager" if loop.first else "lazy") %}{% endfor %}
      </div>
      {% if home.aboutSlides.length > 1 %}
      <button type="button" class="slide-pause" aria-label="Pause slideshow">Pause</button>
      <button type="button" class="slide-btn slide-prev" aria-label="Previous photo">&#8249;</button>
      <button type="button" class="slide-btn slide-next" aria-label="Next photo">&#8250;</button>
      <div class="slide-dots">{% for s in home.aboutSlides %}<button type="button" class="slide-dot{% if loop.first %} active{% endif %}" aria-label="Photo {{ loop.index }} of {{ home.aboutSlides.length }}"></button>{% endfor %}</div>
      {% endif %}
    </div>
  </div>
  <div style="display:flex;flex-direction:column;gap:20px">
    {% for p in home.aboutParas %}<p class="p-body" style="margin:0">{{ p }}</p>{% endfor %}
    <div style="display:flex;flex-direction:column;gap:18px;padding-top:8px">
      <div class="stat-row"><span class="icon-tile">{% icon "eye" %}</span><div class="stat-block"><span class="stat-label">Our vision</span><span class="stat-value">{{ home.vision }}</span></div></div>
      <div class="stat-row"><span class="icon-tile">{% icon "target" %}</span><div class="stat-block"><span class="stat-label">Our mission</span><span class="stat-value">{{ home.mission }}</span></div></div>
      <div class="stat-row"><span class="icon-tile">{% icon "heart" %}</span><div class="stat-block"><span class="stat-label">What we believe</span><span class="stat-value">{{ home.belief }}</span></div></div>
      <div style="display:flex;gap:10px;flex-wrap:wrap;padding-top:2px">
        {% for v in home.values %}<span class="value-chip">{{ v }}</span>{% endfor %}
      </div>
    </div>
  </div>
</div>

<div id="treatment" class="section-tight bg-alt">
  <div style="display:flex;align-items:flex-end;justify-content:space-between;gap:32px;flex-wrap:wrap;padding-bottom:38px">
    <div style="display:flex;flex-direction:column;gap:16px">
      <div class="kicker">{% icon "activity" %}Treatment services</div>
      <h2 class="h2">{{ home.treatmentTitle }}</h2>
    </div>
    <p style="margin:0;font-size:1rem;line-height:1.6;color:#5A554B;max-width:34ch">{{ home.treatmentIntro }}</p>
  </div>
  <div class="grid-cards">
    {% set serviceIcons = ["activity", "home", "users", "refresh-cw"] %}
    {% for s in home.services %}
    <div class="service-card">
      <span class="icon-tile" style="align-self:flex-start">{% icon serviceIcons[loop.index0] %}</span>
      <div style="display:flex;align-items:baseline;gap:12px">
        <span class="num">{{ s.num }}</span>
        <h3 class="h3">{{ s.title }}</h3>
      </div>
      <p style="margin:0;font-size:0.9688rem;line-height:1.62;color:var(--ink-soft)">{{ s.body }}</p>
    </div>
    {% endfor %}
  </div>
  <div style="display:flex;gap:12px;flex-wrap:wrap;margin-top:26px">
    <a href="/treatment/" class="btn btn-primary">See what treatment looks like &#8594;</a>
    <a href="/aftercare/" class="btn btn-outline">Aftercare &amp; support</a>
  </div>
  <div style="margin-top:20px;height:clamp(340px,40vw,520px);overflow:hidden">
    {% image home.treatmentImage, "A group of people holding hands together", "100vw", "", "width:100%;height:100%;object-fit:cover;object-position:center 35%" %}
  </div>
</div>

<div id="programmes" class="section grid grid-2" style="align-items:start">
  <div style="display:flex;flex-direction:column;gap:18px">
    <div class="kicker">{% icon "clock" %}Programmes</div>
    <h2 class="h2">{{ home.programmesTitle }}</h2>
    <p class="p-body" style="margin:0">{{ home.programmesIntro }}</p>
    <a href="tel:{{ site.phoneHref }}" style="font-weight:600;font-size:1rem;border-bottom:1px solid #C9A08C;align-self:flex-start;padding-bottom:2px">Ask which programme fits &#8594;</a>
  </div>
  <div style="display:flex;flex-direction:column">
    {% for p in home.programmes %}
    <div class="programme-row">
      <div style="display:flex;flex-direction:column;gap:3px">
        <span class="serif" style="font-size:1.4375rem;color:var(--ink)">{{ p.title }}</span>
        <span style="font-size:0.9062rem;color:var(--muted)">{{ p.note }}</span>
      </div>
      <span class="programme-length">{% icon "clock" %} {{ p.length }}</span>
    </div>
    {% endfor %}
  </div>
</div>

<div id="family" class="grid grid-2 bg-card border-top border-bottom" style="gap:0">
  <div style="min-height:clamp(260px,50vw,380px);overflow:hidden;background:#E4DACB">
    {% image home.familyImage, "A father carrying his child on his back", "(min-width: 900px) 50vw, 100vw", "", "width:100%;height:100%;object-fit:cover" %}
  </div>
  <div class="hero-copy">
    <div class="kicker">{% icon "heart" %}Family therapy</div>
    <h2 class="h2" style="font-size:clamp(1.75rem,3.4vw,2.25rem)">{{ home.familyTitle }}</h2>
    <p class="p-body" style="margin:0">{{ home.familyBody }}</p>
    <div style="display:flex;flex-direction:column;gap:10px;padding-top:4px">
      {% for b in home.familyBenefits %}
      <div style="display:flex;gap:12px;align-items:baseline;font-size:1rem;color:#3C382F">
        <span class="bullet-check">{% icon "check" %}</span><span>{{ b }}</span>
      </div>
      {% endfor %}
    </div>
    <a href="tel:{{ site.phoneHref }}" class="btn btn-primary" style="align-self:flex-start;margin-top:6px">{% icon "phone" %}Ask about family therapy</a>
  </div>
</div>

<div class="grid grid-2 bg-dark" style="gap:0">
  <div class="hero-copy">
    <div class="kicker" style="color:var(--accent-light)">{% icon "info" %}Is addiction a disease?</div>
    <h2 class="h2" style="color:#FFFDF9;font-size:clamp(1.75rem,3.5vw,2.375rem)">{{ home.diseaseTitle }}</h2>
    <p style="margin:0;font-size:1.0625rem;line-height:1.68;color:var(--dark-text-soft);text-wrap:pretty">{{ home.diseaseBody }}</p>
    <p style="margin:0;font-size:0.9375rem;line-height:1.6;color:var(--dark-muted)">{{ home.diseaseNote }}</p>
    <a href="/addiction-explained/" style="align-self:flex-start;color:var(--accent-light);font-weight:600;font-size:1rem;border-bottom:1px solid #6E6455;padding-bottom:2px;margin-top:4px">Read the full explanation — types, dependency, causes &#8594;</a>
  </div>
  <div class="hero-copy" style="border-left:1px solid var(--dark-border)">
    <div style="font-size:0.9062rem;color:var(--dark-muted);padding-bottom:6px">The four marks of addictive behaviour (DSM-5)</div>
    {% for m in home.marks %}
    <div class="mark-row">
      <span class="n">{{ m.num }}</span>
      <div style="display:flex;flex-direction:column;gap:5px">
        <span class="serif" style="font-size:1.25rem;color:#FFFDF9">{{ m.title }}</span>
        <span style="font-size:0.9375rem;line-height:1.58;color:var(--dark-text-soft)">{{ m.body }}</span>
      </div>
    </div>
    {% endfor %}
  </div>
</div>

<div id="selfcheck" class="section">
  <div style="display:flex;flex-direction:column;gap:14px;padding-bottom:34px;max-width:62ch">
    <div class="kicker">{% icon "check" %}A quiet self-check</div>
    <h2 class="h2">Tick anything that feels familiar — for you, or for someone you love.</h2>
    <p class="p-body" style="margin:0">Nothing is recorded, and nothing is sent unless you choose to share it. This is only for you to see clearly.</p>
  </div>
  <div class="signs-grid">
    {% for s in home.signs %}
    <div class="sign-box">
      <span class="sign-tick">&#10003;</span>
      <div style="display:flex;flex-direction:column;gap:3px">
        <span class="sign-label">{{ s.label }}</span>
        <span class="sign-hint">{{ s.hint }}</span>
      </div>
    </div>
    {% endfor %}
  </div>
  <div class="check-result">
    <div style="display:flex;flex-direction:column;gap:6px;max-width:62ch">
      <span class="serif" data-check-headline style="font-size:1.5rem;line-height:1.25;color:var(--ink)">Nothing ticked yet.</span>
      <span data-check-body style="font-size:0.9688rem;line-height:1.6;color:var(--ink-soft)">Read through the list slowly. Recognising a pattern is the first honest step, and it is the hardest one.</span>
    </div>
    <div class="check-buttons">
      <a href="tel:{{ site.phoneHref }}" class="btn btn-primary" style="white-space:nowrap">{% icon "phone" %}Call {{ site.phone }}</a>
      <div class="check-actions" data-check-actions data-wa-base="https://wa.me/{{ site.whatsapp }}" data-wa-intro="{{ site.whatsappMessage }}">
        <a href="https://wa.me/{{ site.whatsapp }}" class="btn btn-wa" rel="noopener" data-check-wa>{% icon "message-circle" %}<span data-check-wa-label>WhatsApp us</span></a>
      </div>
    </div>
  </div>
</div>

<div class="quote-band">
  {% image home.quoteImage, "A group of people standing together in the open air", "100vw", "bg-img" %}
  <div class="content">
    <p>&#8220;{{ home.quote }}&#8221;</p>
    <span class="attribution">{{ home.quoteAttribution }}</span>
  </div>
</div>

<div class="section bg-alt">
  <div class="kicker" style="padding-bottom:30px">{% icon "message-circle" %}In our clients' words</div>
  <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:20px">
    {% for t in home.testimonials %}
    <figure class="testimonial-card">
      <span class="icon-tile">{% icon "quote" %}</span>
      <blockquote><p>&#8220;{{ t.quote }}&#8221;</p></blockquote>
      <figcaption class="who">{{ t.who }}</figcaption>
    </figure>
    {% endfor %}
  </div>
</div>

<div id="contact" class="contact-tabs" data-tabs>
<div class="tabs-frame">
  <div class="tabs-list" role="tablist" aria-label="Contact us and common questions">
    {% if site.formEndpoint %}<button type="button" class="tab" role="tab" id="tab-callback" aria-controls="callback">{% icon "phone" %}Call-back request</button>{% endif %}
    <button type="button" class="tab" role="tab" id="tab-find-us" aria-controls="find-us">{% icon "map-pin" %}Find us</button>
    <button type="button" class="tab" role="tab" id="tab-faq" aria-controls="faq">{% icon "info" %}Questions</button>
  </div>

  {% if site.formEndpoint %}
  <div id="callback" class="tab-panel" role="tabpanel" aria-labelledby="tab-callback">
  <div class="grid grid-2 tab-grid">
    <div style="display:flex;flex-direction:column;gap:16px">
      <div class="kicker">{% icon "phone" %}Not ready to phone?</div>
      <h2 class="h2" style="font-size:clamp(1.75rem,3.4vw,2.25rem)">Leave your number. We will call you.</h2>
      <p class="p-body" style="margin:0">Tell us a good time and we will ring you back. You can ask about fees, programmes or how to bring someone in. Nothing you share obliges you to anything, and it stays between us.</p>
      <p style="margin:0;font-size:1rem;line-height:1.6;color:var(--ink-soft)">Prefer to type? <a href="https://wa.me/{{ site.whatsapp }}?text={{ site.whatsappMessage | urlencode }}" rel="noopener" style="font-weight:600">Message us on WhatsApp</a>.</p>
      {% if home.callbackImage %}<div class="tab-photo">{% image home.callbackImage, home.callbackImageAlt, "(min-width: 900px) 40vw, 90vw", "", "object-position:" + (home.callbackImagePosition or "center"), "now" %}</div>{% endif %}
    </div>
    <form class="callback" id="callback-form" method="POST" action="{{ site.formEndpoint }}" data-next="/thanks/">
      <p class="form-hp" aria-hidden="true"><label>Leave this empty: <input name="_gotcha" tabindex="-1" autocomplete="off"></label></p>
      <input type="hidden" name="_subject" value="Call-back request from the website">
      <label>Your name
        <input type="text" name="name" autocomplete="name" placeholder="Your full name" required>
      </label>
      <label>Phone number
        <input type="tel" name="phone" autocomplete="tel" inputmode="tel" placeholder="e.g. 0712 345 678" required>
      </label>
      <label>Best time to call
        <select name="best-time">
          <option>Any time</option>
          <option>Morning</option>
          <option>Afternoon</option>
          <option>Evening</option>
        </select>
      </label>
      <label>Anything you would like us to know <span style="font-weight:400;color:var(--muted2)">(optional)</span>
        <textarea name="message" rows="3" placeholder="For example, who you are worried about, or what you would like to ask"></textarea>
      </label>
      <p class="hint">We only use your number to call you back. We will not share it.</p>
      <p class="hint form-error" role="alert" hidden>Sorry, that didn't send. Please call {{ site.phone }} or message us on WhatsApp.</p>
      <button type="submit" class="btn btn-primary" style="align-self:flex-start">{% icon "phone" %}Request a call back</button>
    </form>
  </div>
  </div>
  {% endif %}

  <div id="find-us" class="tab-panel" role="tabpanel" aria-labelledby="tab-find-us">
    <div class="grid grid-2" style="align-items:start">
  <div style="display:flex;flex-direction:column;gap:18px">
    <div class="kicker">{% icon "map-pin" %}Find us</div>
    <h2 class="h2">{{ site.locationTitle }}</h2>
    <p class="p-body" style="margin:0">{{ site.locationLine }}</p>
    <div style="display:flex;flex-direction:column;gap:10px;padding-top:8px;font-size:1rem;color:#3C382F">
      <div class="contact-row"><span class="k">{% icon "phone" %}<span class="sr-only">Phone</span></span><span>{{ site.phone }} &middot; {{ site.phone2 }}</span></div>
      <div class="contact-row"><span class="k">{% icon "message-circle" %}<span class="sr-only">WhatsApp</span></span><a href="https://wa.me/{{ site.whatsapp }}?text={{ site.whatsappMessage | urlencode }}" rel="noopener">Message us on WhatsApp</a></div>
      <div class="contact-row"><span class="k">{% icon "mail" %}<span class="sr-only">Email</span></span><span style="min-width:0;overflow-wrap:anywhere">{{ site.email }}</span></div>
      <div class="contact-row"><span class="k">{% icon "inbox" %}<span class="sr-only">Post</span></span><span>{{ site.address }}</span></div>
    </div>
  </div>
  <div class="map-wrap">
    <iframe class="map-frame" src="{{ site.mapEmbedUrl }}" title="Map showing the location of {{ site.name }} {{ site.tagline }} in Webuye" loading="lazy" referrerpolicy="no-referrer-when-downgrade" allowfullscreen></iframe>
    <a href="{{ site.mapLinkUrl }}" class="map-link" target="_blank" rel="noopener">Open in Google Maps &#8599;</a>
  </div>
    </div>
  </div>

  <div id="faq" class="tab-panel" role="tabpanel" aria-labelledby="tab-faq">
  <div class="grid grid-2 tab-grid">
    <div style="display:flex;flex-direction:column;gap:16px">
      <div class="kicker">{% icon "info" %}Questions families ask</div>
      <h2 class="h2" style="font-size:clamp(1.75rem,3.4vw,2.25rem)">Before you call.</h2>
      <p style="margin:0;font-size:1rem;line-height:1.65;color:var(--ink-soft)">If your question isn't here, ask it on the phone. Nothing you say obliges you to anything.</p>
      {% if home.faqImage %}<div class="tab-photo">{% image home.faqImage, home.faqImageAlt, "(min-width: 900px) 40vw, 90vw", "", "object-position:" + (home.faqImagePosition or "center"), "now" %}</div>{% endif %}
    </div>
    <div style="display:flex;flex-direction:column">
      {% for f in home.faqs %}
      <details class="faq-item">
        <summary>{{ f.q }}</summary>
        <p>{{ f.a }}</p>
      </details>
      {% endfor %}
    </div>
  </div>
  </div>
</div>
</div>

<script type="application/ld+json">
{{ { "@context": "https://schema.org", "@type": "FAQPage", "mainEntity": faqLd } | dump | safe }}
</script>
