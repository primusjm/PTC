---
layout: base.njk
title: Treatment
nav: treatment
permalink: /treatment/
description: "What treatment actually looks like at Promises Treatment Centre — detox, residential care and a typical week."
---
<div class="grid-hero">
  <div class="hero-copy">
    <div class="breadcrumb"><a href="/" style="color:var(--accent)">Home</a><span class="sep">/</span><span style="color:var(--muted)">Treatment</span></div>
    <h1 class="h1" style="font-size:clamp(2.125rem,4.6vw,3.375rem)">{{ treatment.heroTitle }}</h1>
    <p class="p-lead">{{ treatment.heroBody }}</p>
    <div style="display:flex;gap:10px;flex-wrap:wrap;padding-top:4px">
      {% for j in treatment.jumps %}<a href="{{ j.href }}" class="jump-chip">{{ j.label }}</a>{% endfor %}
    </div>
  </div>
  <div class="hero-media">
    {% image treatment.heroImage, "Two people holding each other's hands", "(min-width: 900px) 50vw, 100vw", "", "", "eager" %}
  </div>
</div>

<div class="section-tight bg-alt">
  <div class="grid grid-2" style="align-items:start">
    <div style="display:flex;flex-direction:column;gap:16px">
      <div class="kicker">{% icon "leaf" %}Our philosophy</div>
      <h2 class="h2">{{ treatment.philosophyTitle }}</h2>
    </div>
    <div style="display:flex;flex-direction:column;gap:18px">
      {% for p in treatment.philosophyParas %}<p class="p-body" style="margin:0">{{ p }}</p>{% endfor %}
    </div>
  </div>
</div>

<div id="detox" class="section-tight">
  <div style="display:flex;align-items:flex-end;justify-content:space-between;gap:32px;flex-wrap:wrap;padding-bottom:34px">
    <div style="display:flex;flex-direction:column;gap:14px">
      <div class="kicker">{% icon "droplet" %}Stage one &middot; Detoxification</div>
      <h2 class="h2">{{ treatment.detoxTitle }}</h2>
    </div>
    <p style="margin:0;font-size:1rem;line-height:1.6;color:#5A554B;max-width:36ch">{{ treatment.detoxIntro }}</p>
  </div>
  <div class="grid-2-tight" style="display:grid">
    {% for d in treatment.detoxSteps %}
    <div class="service-card">
      <span class="num">{{ d.num }}</span>
      <h3 class="h3">{{ d.title }}</h3>
      <p style="margin:0;font-size:0.9688rem;line-height:1.62;color:var(--ink-soft)">{{ d.body }}</p>
    </div>
    {% endfor %}
  </div>
  <div class="callout-dark">
    <span class="tag">{% icon "info" %} Important</span>
    <p>{{ treatment.detoxWarning }}</p>
  </div>
</div>

<div id="residential" class="section-tight bg-card border-top border-bottom">
  <div style="display:flex;flex-direction:column;gap:14px;max-width:64ch;padding-bottom:36px">
    <div class="kicker">{% icon "home" %}Stage two &middot; Residential treatment</div>
    <h2 class="h2">{{ treatment.residentialTitle }}</h2>
    <p class="p-body" style="margin:0">{{ treatment.residentialBody }}</p>
  </div>
  <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,300px),1fr));gap:1px;background:var(--border);border:1px solid var(--border)">
    {% set featureIcons = ["home", "calendar", "message-circle", "activity", "users", "sun"] %}
    {% for f in treatment.features %}
    <div style="background:var(--bg-card);padding:26px 26px;display:flex;flex-direction:column;gap:9px">
      <span class="icon-tile" style="align-self:flex-start">{% icon featureIcons[loop.index0] %}</span>
      <h3 class="h3" style="font-size:1.3125rem;line-height:1.22">{{ f.title }}</h3>
      <p style="margin:0;font-size:0.9688rem;line-height:1.6;color:var(--ink-soft)">{{ f.body }}</p>
    </div>
    {% endfor %}
  </div>
</div>

<div id="week" class="section-tight bg-alt">
  <div class="grid grid-2" style="align-items:start">
    <div style="display:flex;flex-direction:column;gap:16px">
      <div class="kicker">{% icon "calendar" %}A week here</div>
      <h2 class="h2" style="font-size:clamp(1.75rem,3.4vw,2.25rem)">{{ treatment.weekTitle }}</h2>
      <p class="p-body" style="margin:0">{{ treatment.weekIntro }}</p>
      <div style="height:clamp(220px,26vw,300px);overflow:hidden;background:#E4DACB;margin-top:6px">
        {% image treatment.weekImage, "A group of hands holding one another", "(min-width: 900px) 50vw, 100vw", "", "width:100%;height:100%;object-fit:cover" %}
      </div>
    </div>
    <div style="display:flex;flex-direction:column">
      {% set weekIcons = ["users", "message-circle", "heart", "book-open"] %}
      {% for w in treatment.weekParts %}
      <div style="display:flex;flex-direction:column;gap:6px;padding:22px 0;border-bottom:1px solid #DFD4C2">
        <div style="display:flex;align-items:baseline;gap:12px;flex-wrap:wrap">
          <span class="icon-tile icon-tile-light" style="width:36px;height:36px;align-self:center">{% icon weekIcons[loop.index0] %}</span><span class="serif" style="font-size:1.4375rem;color:var(--ink)">{{ w.title }}</span>
          <span style="font-family:ui-monospace,Menlo,monospace;font-size:0.7188rem;letter-spacing:0.08em;color:var(--accent)">{{ w.cadence }}</span>
        </div>
        <p style="margin:0;font-size:0.9688rem;line-height:1.62;color:var(--ink-soft)">{{ w.body }}</p>
      </div>
      {% endfor %}
    </div>
  </div>
</div>

<div id="benefits" class="section-tight bg-dark">
  <div style="display:flex;flex-direction:column;gap:14px;max-width:60ch;padding-bottom:36px">
    <div class="kicker" style="color:var(--accent-light)">{% icon "shield-check" %}Why residential, not outpatient</div>
    <h2 class="h2" style="color:#FFFDF9;font-size:clamp(1.75rem,3.5vw,2.375rem)">{{ treatment.benefitsTitle }}</h2>
  </div>
  <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,300px),1fr));gap:26px 34px">
    {% set benefitIcons = ["shield-check", "calendar", "message-circle", "clock", "users", "leaf"] %}
    {% for b in treatment.benefits %}
    <div style="display:flex;gap:16px;align-items:flex-start">
      <span style="font-family:ui-monospace,Menlo,monospace;font-size:0.7188rem;color:var(--accent-light);padding-top:6px;flex:0 0 auto">{{ b.num }}</span>
      <div style="display:flex;flex-direction:column;gap:6px">
        <span class="serif" style="font-size:1.3125rem;color:#FFFDF9"><span style="color:var(--accent-light)">{% icon benefitIcons[loop.index0] %}</span>&nbsp; {{ b.title }}</span>
        <span style="font-size:0.9688rem;line-height:1.6;color:var(--dark-text-soft)">{{ b.body }}</span>
      </div>
    </div>
    {% endfor %}
  </div>
</div>

<div class="section" style="display:flex;flex-direction:column;gap:22px;align-items:flex-start;max-width:70ch">
  <div class="kicker">{% icon "arrow-right" %}Next</div>
  <h2 class="h2" style="font-size:clamp(1.625rem,3.2vw,2.125rem)">Treatment does not end at discharge. Read what happens after.</h2>
  <div style="display:flex;gap:12px;flex-wrap:wrap;padding-top:2px">
    <a href="/aftercare/" class="btn btn-primary">Aftercare &amp; support &#8594;</a>
    <a href="/addiction-explained/" class="btn btn-outline">Addiction explained</a>
  </div>
</div>
